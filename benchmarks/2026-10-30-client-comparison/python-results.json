        "label": "indexed filter + top 10",
        "sql": "SELECT order_id, product, quantity FROM flightperf_12f3af966f3f_sales WHERE country = 'JPN' AND status = 'shipped' ORDER BY quantity DESC LIMIT 10"
      },
      {
        "label": "indexed range COUNT",
        "sql": "SELECT COUNT(*) FROM flightperf_12f3af966f3f_sales WHERE quantity BETWEEN 5 AND 10"
      },
      {
