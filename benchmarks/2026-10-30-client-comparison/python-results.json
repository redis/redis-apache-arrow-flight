        "sql": "SELECT COUNT(*) FROM flightperf_12f3af966f3f_sales WHERE product LIKE 'gi%'"
      },
      {
        "label": "interval range COUNT",
        "sql": "SELECT COUNT(*) FROM flightperf_12f3af966f3f_sales WHERE ordered_at >= TIMESTAMP '2025-12-31 00:00:00' - INTERVAL '30 days'"
      },
      {
        "label": "GROUP BY, index reduce",
        "sql": "SELECT country, COUNT(*), SUM(quantity) FROM flightperf_12f3af966f3f_sales GROUP BY country"
      },
      {
        "label": "GROUP BY, driver (AVG double)",
        "sql": "SELECT country, AVG(discount) FROM flightperf_12f3af966f3f_sales GROUP BY country"
      },
      {
        "label": "GROUP BY expression, driver",
        "sql": "SELECT product, SUM(quantity * unit_price) FROM flightperf_12f3af966f3f_sales GROUP BY product"
      },
      {
        "label": "GROUP BY DATE_TRUNC, driver",
        "sql": "SELECT DATE_TRUNC('month', ordered_at) AS m, COUNT(*) FROM flightperf_12f3af966f3f_sales GROUP BY m ORDER BY m"
      },
      {
        "label": "non-indexed filter (scan)",
        "sql": "SELECT COUNT(*) FROM flightperf_12f3af966f3f_sales WHERE notes LIKE '%order 1%'"
      },
      {
