        "sql": "SELECT order_id, country, quantity FROM flightperf_12f3af966f3f_sales WHERE order_id <= 10000"
      },
      {
        "label": "full scan, all columns",
        "sql": "SELECT * FROM flightperf_12f3af966f3f_sales"
      },
      {
        "label": "selective join (index lookup)",
        "sql": "SELECT c.name, COUNT(*) FROM flightperf_12f3af966f3f_sales s JOIN flightperf_12f3af966f3f_customers c ON s.customer_id = c.customer_id WHERE c.country = 'JPN' AND s.status = 'shipped' GROUP BY c.name"
      },
      {
        "label": "unfiltered join (hash join)",
        "sql": "SELECT c.country, COUNT(*) FROM flightperf_12f3af966f3f_sales s JOIN flightperf_12f3af966f3f_customers c ON s.customer_id = c.customer_id GROUP BY c.country"
      },
      {
        "label": "correlated subquery (50 rows)",
        "sql": "SELECT c.name, (SELECT COUNT(*) FROM flightperf_12f3af966f3f_sales s WHERE s.customer_id = c.customer_id) FROM flightperf_12f3af966f3f_customers c"
      },
      {
        "label": "IN (SELECT \u2026), half the rows",
        "sql": "SELECT COUNT(*) FROM flightperf_12f3af966f3f_sales WHERE order_id IN (SELECT order_id FROM flightperf_12f3af966f3f_sales WHERE quantity > 10)"
      },
      {
        "label": "correlated EXISTS (semi-join)",
        "sql": "SELECT COUNT(*) FROM flightperf_12f3af966f3f_sales s WHERE EXISTS (SELECT 1 FROM flightperf_12f3af966f3f_sales r WHERE r.order_id = s.order_id AND r.quantity > 10)"
      },
      {
        "label": "correlated EXISTS, no inner rows",
        "sql": "SELECT COUNT(*) FROM flightperf_12f3af966f3f_sales s WHERE EXISTS (SELECT 1 FROM flightperf_12f3af966f3f_sales r WHERE r.order_id = s.order_id AND r.quantity > 20)"
      },
      {
        "label": "UNION of two filters",
        "sql": "SELECT order_id FROM flightperf_12f3af966f3f_sales WHERE country = 'JPN' AND quantity = 20 UNION SELECT order_id FROM flightperf_12f3af966f3f_sales WHERE product = 'gizmo' AND quantity = 20"
      },
      {
        "label": "view with pushed filter",
        "sql": "SELECT COUNT(*) FROM flightperf_12f3af966f3f_bench_shipped WHERE country = 'JPN' AND quantity >= 15"
      }
